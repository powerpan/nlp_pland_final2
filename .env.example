# Copy to .env (never commit it). Only DeepSeek or HKGAI may be used as model backends.

# --- DeepSeek (default provider) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash          # or deepseek-v4-pro

# --- HKGAI (OpenAI-compatible endpoint; fill in the values from your HKGAI console) ---
# HKGAI has no web search or fetch API: keep DEEPSEEK_API_KEY set and web_search / web_fetch use DeepSeek's.
# HKGAI_API_KEY=
# HKGAI_BASE_URL=
# HKGAI_MODEL=

# Which provider to use when a profile does not pin one: deepseek | hkgai
# PLAND_PROVIDER=deepseek

# Where profiles, memories, sessions and workspaces live (default: ~/.pland)
# PLAND_HOME=

# Optional web search API keys (DuckDuckGo/Bing HTML scraping is used when unset)
# TAVILY_API_KEY=
# SEARXNG_URL=
